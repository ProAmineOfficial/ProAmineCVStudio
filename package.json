{
  "name": "proamine-cv-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A free, open-source CV studio with editable Word, PDF, image and data exports.",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.2.8",
    "@pdf-lib/fontkit": "^1.1.1",
    "docx": "^9.5.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.1.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
